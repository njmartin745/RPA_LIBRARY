    - waits for visibility
    - scrolls into view
    - optionally clears before typing

    Raises RuntimeError with context on failure.
    """
    by_ = _normalize_by(by)
    el = wait_for_visible(driver, by_, locator, timeout)
    _scroll_into_view(driver, el)

