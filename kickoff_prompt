def open_manifest(cfg: MutableMapping[str, Any]):
    """
    PIPE-facing opener.
    Returns a ManifestWriter over the configured manifest path.

    Looks for (in order):
      - cfg["MANIFEST_PATH"]
      - cfg["MANIFEST"]
      - default "data/manifest.jsonl"
